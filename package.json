{
  "name": "dsh-record-and-replay",
  "version": "0.1.0",
  "type": "module",
  "description": "Cua Driver-only browser record/replay for DSH (host plugin)",
  "author": "kakaCat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakaCat/dsh-record-and-replay.git"
  },
  "homepage": "https://github.com/kakaCat/dsh-record-and-replay#readme",
  "bugs": {
    "url": "https://github.com/kakaCat/dsh-record-and-replay/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cua",
    "record",
    "replay",
    "browser-automation",
    "computer-use",
    "skill"
  ],
  "license": "MIT",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "dsh-record-replay": "./dist/cli.mjs",
    "dsh-record-and-replay": "./dist/cli.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "default": "./dist/client/client.js"
    },
    "./desktop": {
      "types": "./dist/desktop.d.mts",
      "import": "./dist/desktop.mjs",
      "default": "./dist/desktop.mjs"
    },
    "./docker": {
      "types": "./dist/docker.d.mts",
      "import": "./dist/docker.mjs",
      "default": "./dist/docker.mjs"
    },
    "./docker/locale/*.json": "./docker/locale/*.json",
    "./docker/icon": "./docker/icon.svg"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "REFERENCE.md",
    "cordis.patch.yml",
    "dist",
    "docker",
    "docs/screenshots"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "scripts": {
    "spike:cua": "tsx tests/spikes/cua-binding.test.ts",
    "build": "tsdown -c tsdown.config.mjs && tsc -p tsconfig.client.json && vite build && vite build -c vite.client.config.mjs",
    "build:client": "tsc -p tsconfig.client.json",
    "build:panel": "vite build",
    "build:ds-client": "vite build -c vite.client.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:activity": "playwright test tests/e2e/activity-view.spec.ts --project=chromium",
    "dev:panel": "vite",
    "check:boundary": "node scripts/check-public-boundary.mjs",
    "check:history": "node scripts/check-git-history.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@trycua/cua-driver": "0.28.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@playwright/test": "1.56.0",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.24",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
